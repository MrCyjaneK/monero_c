+// generic serializer for unordered_map
+template <class Archive, class K, class V>
+inline void serialize(Archive& ar, std::unordered_map<K, V>& m)
+{
+    size_t size = m.size();
+    auto array_scope = ar.begin_array(size); // RAII handle for array
+
+    if constexpr (Archive::is_deserializer)
+    {
+        m.clear();
+        for (size_t i = 0; i < size; ++i)
+        {
+            auto obj_scope = ar.begin_object();
+            K k;
+            V v;
+            field(ar, "key", k);
+            field(ar, "value", v);
+            m.emplace(std::move(k), std::move(v));
+        }
+    }
+    else
+    {
+        for (auto &kv : m)
+        {
+            auto obj_scope = ar.begin_object();
+            field(ar, "key", const_cast<K&>(kv.first));
+            field(ar, "value", kv.second);
+        }
+    }
+}
+
+// generic serializer for unordered_multimap
+template <class Archive, class K, class V>
+inline void serialize(Archive& ar, std::unordered_multimap<K, V>& m)
+{
+    size_t size = m.size();
+    auto array_scope = ar.begin_array(size); // RAII array handle
+
+    if constexpr (Archive::is_deserializer)
+    {
+        m.clear();
+        for (size_t i = 0; i < size; ++i)
+        {
+            auto obj_scope = ar.begin_object();
+            K k;
+            V v;
+            field(ar, "key", k);
+            field(ar, "value", v);
+            m.emplace(std::move(k), std::move(v));
+        }
+    }
+    else
+    {
+        for (auto &kv : m)
+        {
+            auto obj_scope = ar.begin_object();
+            field(ar, "key", const_cast<K&>(kv.first));
+            field(ar, "value", kv.second);
+        }
+    }
+}
+
+// serialize std::pair<const K, V>
+template <class Archive, class K, class V>
+inline void value(Archive &ar, std::pair<const K, V> &p)
+{
+    K &key = const_cast<K &>(p.first);
+    value(ar, key);
+    value(ar, p.second);
+}
+
+// serialize std::map
+template <class Archive, class K, class V>
+inline void value(Archive &ar, std::map<K, V> &m)
+{
+    size_t n = m.size();
+    value(ar, n);
+
+    if constexpr (Archive::is_deserializer)
+    {
+        m.clear();
+        for (size_t i = 0; i < n; ++i)
+        {
+            std::pair<K, V> kv;
+            value(ar, kv);
+            m.insert(std::move(kv));
+        }
+    }
+    else
+    {
+        for (auto &kv : m)
+            value(ar, kv);
+    }
+}
+
+// serialize std::multimap
+template <class Archive, class K, class V>
+inline void value(Archive &ar, std::multimap<K, V> &m)
+{
+    size_t n = m.size();
+    value(ar, n);
+
+    if constexpr (Archive::is_deserializer)
+    {
+        m.clear();
+        for (size_t i = 0; i < n; ++i)
+        {
+            std::pair<K, V> kv;
+            value(ar, kv);
+            m.insert(std::move(kv));
+        }
+    }
+    else
+    {
+        for (auto &kv : m)
+            value(ar, kv);
+    }
+}
 
