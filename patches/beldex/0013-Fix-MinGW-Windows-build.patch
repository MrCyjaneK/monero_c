From 03dbf62786cf2b848abc6c9fc045e3718f9afa99 Mon Sep 17 00:00:00 2001
From: Agatha-luna <magambo@beldex.io>
Date: Wed, 1 Apr 2026 15:54:33 +0530
Subject: [PATCH 13/20] Fix MinGW Windows build

---
 CMakeLists.txt            | 39 ++++++++++++++++++++++++++++++++++++++-
 external/CMakeLists.txt   | 15 +++++++++++++++
 src/wallet/api/wallet.cpp |  2 +-
 3 files changed, 54 insertions(+), 2 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index a3b963468..c5777d1e7 100755
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -75,6 +75,43 @@ set(CMAKE_C_STANDARD 11)
 set(CMAKE_C_STANDARD_REQUIRED ON)
 set(CMAKE_C_EXTENSIONS OFF)
 
+if(WIN32 AND DEFINED HOST_ABI AND HOST_ABI MATCHES "mingw")
+  add_compile_options(
+    -fpermissive
+    -Wno-error
+    -Wno-error=extra
+    -Wno-extra
+    -Wno-error=shift-count-overflow
+    -D_GLIBCXX_USE_INT128=1
+    -DJSON_USE_IMPLICIT_CONVERSIONS=0
+  )
+  set(_depends_prefix "${CMAKE_SOURCE_DIR}/../contrib/depends/${HOST_ABI}")
+  set(_bad_dep_include "${_depends_prefix}/usr/include")
+  set(_good_dep_include "${_depends_prefix}/sysroot/mingw/include")
+  foreach(_flag_var
+      CMAKE_C_FLAGS
+      CMAKE_CXX_FLAGS
+      CMAKE_C_FLAGS_DEBUG
+      CMAKE_CXX_FLAGS_DEBUG
+      CMAKE_C_FLAGS_RELEASE
+      CMAKE_CXX_FLAGS_RELEASE
+      CMAKE_C_FLAGS_RELWITHDEBINFO
+      CMAKE_CXX_FLAGS_RELWITHDEBINFO
+      CMAKE_C_FLAGS_MINSIZEREL
+      CMAKE_CXX_FLAGS_MINSIZEREL)
+    if(DEFINED ${_flag_var})
+      string(REPLACE "${_bad_dep_include}" "${_good_dep_include}" ${_flag_var} "${${_flag_var}}")
+      set(${_flag_var} "${${_flag_var}}" CACHE STRING "" FORCE)
+    endif()
+  endforeach()
+endif()
+
+if(WIN32)
+    add_compile_options(-fno-stack-protector)
+    add_compile_options(-U_FORTIFY_SOURCE)
+    add_compile_definitions(_FORTIFY_SOURCE=0)
+endif()
+
 # Add this line to suppress implicit-fallthrough warnings
 set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -Wno-implicit-fallthrough")
 
@@ -473,7 +510,7 @@ endif()
 
 
 option(WITH_SYSTEMD "Attempts to link against and enable systemd daemon notification support" ON)
-if (WITH_SYSTEMD AND NOT BUILD_STATIC_DEPS)
+if (WITH_SYSTEMD AND NOT BUILD_STATIC_DEPS AND NOT ANDROID AND NOT WIN32)
   find_package(PkgConfig REQUIRED)
   pkg_check_modules(SYSTEMD libsystemd IMPORTED_TARGET)
 
diff --git a/external/CMakeLists.txt b/external/CMakeLists.txt
index 7e1d62cd5..a7bfba09b 100755
--- a/external/CMakeLists.txt
+++ b/external/CMakeLists.txt
@@ -127,6 +127,10 @@ if(NOT BUILD_STATIC_DEPS)
   else()
     find_package(CURL REQUIRED COMPONENTS HTTP HTTPS SSL)
   endif()
+
+  if(WIN32 AND CURL_INCLUDE_DIRS)
+    list(FILTER CURL_INCLUDE_DIRS EXCLUDE REGEX "^/usr/include(/.*)?$")
+  endif()
   
   # CURL::libcurl wasn't added to FindCURL until cmake 3.12, so add it if necessary
   if (CMAKE_VERSION VERSION_LESS 3.12 AND NOT TARGET CURL::libcurl)
@@ -137,6 +141,12 @@ if(NOT BUILD_STATIC_DEPS)
     add_library(CURL_libcurl INTERFACE)
     target_link_libraries(CURL_libcurl INTERFACE libcurl)
     add_library(CURL::libcurl ALIAS CURL_libcurl)
+  elseif(WIN32 AND TARGET CURL::libcurl)
+    get_target_property(_curl_include_dirs CURL::libcurl INTERFACE_INCLUDE_DIRECTORIES)
+    if(_curl_include_dirs)
+      list(FILTER _curl_include_dirs EXCLUDE REGEX "^/usr/include(/.*)?$")
+      set_property(TARGET CURL::libcurl PROPERTY INTERFACE_INCLUDE_DIRECTORIES "${_curl_include_dirs}")
+    endif()
   endif()
 endif()
 
@@ -146,6 +156,11 @@ add_library(cpr STATIC EXCLUDE_FROM_ALL ${cpr_sources})
 target_link_libraries(cpr PUBLIC CURL::libcurl)
 target_include_directories(cpr PUBLIC cpr/include)
 target_compile_definitions(cpr PUBLIC CPR_CURL_NOSIGNAL)
+
+if(MINGW)
+    target_compile_definitions(cpr PUBLIC CURL_STATICLIB)
+endif()
+
 add_library(cpr::cpr ALIAS cpr)
 
 file(READ cpr/CMakeLists.txt cpr_cmake_head LIMIT 1000)
diff --git a/src/wallet/api/wallet.cpp b/src/wallet/api/wallet.cpp
index 239043964..6f5c3b344 100755
--- a/src/wallet/api/wallet.cpp
+++ b/src/wallet/api/wallet.cpp
@@ -3863,7 +3863,7 @@ bool WalletImpl::parse_uri(const std::string &uri, std::string &address, std::st
 EXPORT
 std::string WalletImpl::getDefaultDataDir() const
 {
- return tools::get_default_data_dir();
+ return tools::get_default_data_dir().string();
 }
 
 EXPORT
