From 084c276e65bf7f3b737238d131f69f2b5de59cac Mon Sep 17 00:00:00 2001
From: victor-tucci <victor.tucci@beldex.io>
Date: Mon, 12 Jan 2026 06:11:19 +0000
Subject: [PATCH 15/15] add build-time patch packages for loki-mq,
 oxen-encoding, and uSockets

---
 cmake/loki-mq.cmake                           | 20 +++++
 cmake/oxen-encoding.cmake                     | 22 ++++++
 .../patch/loki-mq/001-fix-libzmq-cmake.patch  | 75 +++++++++++++++++++
 .../oxen-encoding/001-fix-serialization.patch | 67 +++++++++++++++++
 cmake/patch/uSockets/001-fix-bsd.patch        | 57 ++++++++++++++
 cmake/uSockets.cmake                          | 23 ++++++
 external/CMakeLists.txt                       |  8 +-
 7 files changed, 270 insertions(+), 2 deletions(-)
 create mode 100644 cmake/loki-mq.cmake
 create mode 100644 cmake/oxen-encoding.cmake
 create mode 100644 cmake/patch/loki-mq/001-fix-libzmq-cmake.patch
 create mode 100644 cmake/patch/oxen-encoding/001-fix-serialization.patch
 create mode 100644 cmake/patch/uSockets/001-fix-bsd.patch
 create mode 100644 cmake/uSockets.cmake

diff --git a/cmake/loki-mq.cmake b/cmake/loki-mq.cmake
new file mode 100644
index 000000000..35683a635
--- /dev/null
+++ b/cmake/loki-mq.cmake
@@ -0,0 +1,20 @@
+# Apply local fixes to loki-mq submodule
+
+set(LOKI_MQ_PATCH
+    "${CMAKE_CURRENT_SOURCE_DIR}/../cmake/patch/loki-mq/001-fix-libzmq-cmake.patch"
+)
+
+if(EXISTS "${LOKI_MQ_PATCH}")
+  message(STATUS "Applying loki-mq local patch")
+
+  execute_process(
+    COMMAND patch -p1 -N -i "${LOKI_MQ_PATCH}"
+    WORKING_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/../external/loki-mq"
+    RESULT_VARIABLE _patch_result
+)
+
+
+  if(NOT _patch_result EQUAL 0 AND NOT _patch_result EQUAL 1)
+    message(FATAL_ERROR "Failed to apply loki-mq patch")
+  endif()
+endif()
diff --git a/cmake/oxen-encoding.cmake b/cmake/oxen-encoding.cmake
new file mode 100644
index 000000000..753460bd3
--- /dev/null
+++ b/cmake/oxen-encoding.cmake
@@ -0,0 +1,22 @@
+# Apply local fixes to oxen-encoding submodule
+
+set(OXEN_ENCODING_PATCH
+    "${CMAKE_CURRENT_SOURCE_DIR}/../cmake/patch/oxen-encoding/001-fix-serialization.patch"
+)
+
+if(EXISTS "${OXEN_ENCODING_PATCH}")
+  message(STATUS "Applying oxen-encoding local patch")
+
+  execute_process(
+    COMMAND patch -p1 -N -i "${OXEN_ENCODING_PATCH}"
+    WORKING_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/../external/oxen-encoding"
+    RESULT_VARIABLE _patch_result
+    OUTPUT_VARIABLE _patch_out
+    ERROR_VARIABLE  _patch_err
+  )
+
+  if(NOT _patch_result EQUAL 0 AND NOT _patch_result EQUAL 1)
+    message(FATAL_ERROR
+      "Failed to apply oxen-encoding patch:\n${_patch_out}\n${_patch_err}")
+  endif()
+endif()
diff --git a/cmake/patch/loki-mq/001-fix-libzmq-cmake.patch b/cmake/patch/loki-mq/001-fix-libzmq-cmake.patch
new file mode 100644
index 000000000..661f61e08
--- /dev/null
+++ b/cmake/patch/loki-mq/001-fix-libzmq-cmake.patch
@@ -0,0 +1,75 @@
+diff --git a/cmake/local-libzmq/LocalLibzmq.cmake b/cmake/local-libzmq/LocalLibzmq.cmake
+index a25adb7..1d93774 100644
+--- a/cmake/local-libzmq/LocalLibzmq.cmake
++++ b/cmake/local-libzmq/LocalLibzmq.cmake
+@@ -15,18 +15,65 @@ file(MAKE_DIRECTORY ${LIBZMQ_PREFIX}/include)
+ 
+ include(ExternalProject)
+ include(ProcessorCount)
++if(WIN32)
++    set(ZMQ_WIN_DEFS
++    -D_WIN32_WINNT=0x0601
++    -DWINVER=0x0601
++    -DNTDDI_VERSION=0x06010000
++)
++endif()
++
++set(ZMQ_COMMON_ARGS
++    -DCMAKE_C_COMPILER=${CMAKE_C_COMPILER}
++    -DCMAKE_CXX_COMPILER=${CMAKE_CXX_COMPILER}
++    -DWITH_LIBSODIUM=OFF
++    -DENABLE_CURVE=OFF
++    -DZMQ_BUILD_TESTS=OFF
++    -DWITH_PERF_TOOL=OFF
++    -DENABLE_DRAFTS=OFF
++    -DBUILD_SHARED=OFF
++    -DBUILD_STATIC=ON
++    -DWITH_DOC=OFF
++    -DCMAKE_INSTALL_PREFIX=${LIBZMQ_PREFIX}
++)
++
++set(ZMQ_WINDOWS_ARGS
++    -DCMAKE_SYSTEM_NAME=Windows
++    -DCMAKE_C_FLAGS=${ZMQ_WIN_DEFS}
++    -DCMAKE_CXX_FLAGS=${ZMQ_WIN_DEFS}
++    -DZMQ_POLL_BASED_ON_SELECT=ON
++    -DZMQ_USE_SELECT=ON
++    -DZMQ_USE_POLL=OFF
++    -DZMQ_USE_EPOLL=OFF
++    -DZMQ_USE_KQUEUE=OFF
++)
++
++if(WIN32)
++    set(ZMQ_PLATFORM_ARGS ${ZMQ_WINDOWS_ARGS})
++else()
++    set(ZMQ_PLATFORM_ARGS "")
++endif()
++
+ ExternalProject_Add(libzmq_external
+     PREFIX ${LIBZMQ_PREFIX}
+     URL ${LIBZMQ_URL}
+     URL_HASH ${LIBZMQ_HASH}
+-    CMAKE_ARGS -DCMAKE_C_COMPILER=${CMAKE_C_COMPILER} -DCMAKE_CXX_COMPILER=${CMAKE_CXX_COMPILER}
+-    -DWITH_LIBSODIUM=ON -DZMQ_BUILD_TESTS=OFF -DWITH_PERF_TOOL=OFF -DENABLE_DRAFTS=OFF
+-    -DBUILD_SHARED=OFF -DBUILD_STATIC=ON -DWITH_DOC=OFF -DCMAKE_INSTALL_PREFIX=${LIBZMQ_PREFIX}
+-    BUILD_BYPRODUCTS ${LIBZMQ_PREFIX}/${CMAKE_INSTALL_LIBDIR}/libzmq.a
+-    )
++
++    CMAKE_ARGS
++        ${ZMQ_COMMON_ARGS}
++        ${ZMQ_PLATFORM_ARGS}
++
++    BUILD_BYPRODUCTS
++        ${LIBZMQ_PREFIX}/${CMAKE_INSTALL_LIBDIR}/libzmq.a
++)
++
+ 
+ add_library(libzmq_vendor STATIC IMPORTED GLOBAL)
+ add_dependencies(libzmq_vendor libzmq_external)
+ set_target_properties(libzmq_vendor PROPERTIES
+     INTERFACE_INCLUDE_DIRECTORIES ${LIBZMQ_PREFIX}/include
+     IMPORTED_LOCATION ${LIBZMQ_PREFIX}/${CMAKE_INSTALL_LIBDIR}/libzmq.a)
++
++if(WIN32)
++    target_compile_definitions(libzmq_vendor INTERFACE ZMQ_STATIC)
++endif()
diff --git a/cmake/patch/oxen-encoding/001-fix-serialization.patch b/cmake/patch/oxen-encoding/001-fix-serialization.patch
new file mode 100644
index 000000000..7b41ac1bf
--- /dev/null
+++ b/cmake/patch/oxen-encoding/001-fix-serialization.patch
@@ -0,0 +1,67 @@
+diff --git a/oxenc/bt_serialize.h b/oxenc/bt_serialize.h
+index 0185a23..8753045 100644
+--- a/oxenc/bt_serialize.h
++++ b/oxenc/bt_serialize.h
+@@ -760,12 +760,14 @@ class bt_list_consumer {
+             throw std::runtime_error{"Cannot create a bt_list_consumer with non-list data"};
+         data.remove_prefix(1);
+     }
+-    bt_list_consumer(std::basic_string_view<unsigned char> data) :
+-            bt_list_consumer{
+-                    std::string_view{reinterpret_cast<const char*>(data.data()), data.size()}} {}
+-    bt_list_consumer(std::basic_string_view<std::byte> data) :
+-            bt_list_consumer{
+-                    std::string_view{reinterpret_cast<const char*>(data.data()), data.size()}} {}
++
++    bt_list_consumer(const std::vector<uint8_t>& data) :
++        bt_list_consumer{
++                std::string_view{reinterpret_cast<const char*>(data.data()), data.size()}} {}
++
++    bt_list_consumer(const std::vector<std::byte>& data) :
++        bt_list_consumer{
++                std::string_view{reinterpret_cast<const char*>(data.data()), data.size()}} {}
+ 
+     /// Copy constructor.  Making a copy copies the current position so can be used for multipass
+     /// iteration through a list.
+@@ -1037,12 +1039,13 @@ class bt_dict_consumer : private bt_list_consumer {
+             throw std::runtime_error{"Cannot create a bt_dict_consumer with non-dict data"};
+         data.remove_prefix(1);
+     }
+-    bt_dict_consumer(std::basic_string_view<unsigned char> data) :
+-            bt_dict_consumer{
+-                    std::string_view{reinterpret_cast<const char*>(data.data()), data.size()}} {}
+-    bt_dict_consumer(std::basic_string_view<std::byte> data) :
+-            bt_dict_consumer{
+-                    std::string_view{reinterpret_cast<const char*>(data.data()), data.size()}} {}
++    bt_dict_consumer(const std::vector<uint8_t>& data) :
++        bt_dict_consumer{
++                std::string_view{reinterpret_cast<const char*>(data.data()), data.size()}} {}
++
++    bt_dict_consumer(const std::vector<std::byte>& data) :
++        bt_dict_consumer{
++                std::string_view{reinterpret_cast<const char*>(data.data()), data.size()}} {}
+ 
+     /// Copy constructor.  Making a copy copies the current position so can be used for multipass
+     /// iteration through a list.
+diff --git a/oxenc/endian.h b/oxenc/endian.h
+index 8350ae8..1e51411 100644
+--- a/oxenc/endian.h
++++ b/oxenc/endian.h
+@@ -11,9 +11,17 @@
+ #define bswap_32(x) _byteswap_ulong(x)
+ #define bswap_64(x) _byteswap_uint64(x)
+ #elif defined(__clang__) || defined(__GNUC__)
++#ifndef bswap_16
+ #define bswap_16(x) __builtin_bswap16(x)
++#endif
++
++#ifndef bswap_32
+ #define bswap_32(x) __builtin_bswap32(x)
++#endif
++
++#ifndef bswap_64
+ #define bswap_64(x) __builtin_bswap64(x)
++#endif
+ #elif defined(__linux__)
+ extern "C" {
+ #include <byteswap.h>
diff --git a/cmake/patch/uSockets/001-fix-bsd.patch b/cmake/patch/uSockets/001-fix-bsd.patch
new file mode 100644
index 000000000..a1e2fca12
--- /dev/null
+++ b/cmake/patch/uSockets/001-fix-bsd.patch
@@ -0,0 +1,57 @@
+diff --git a/src/bsd.c b/src/bsd.c
+index b06b30d..118fc03 100644
+--- a/src/bsd.c
++++ b/src/bsd.c
+@@ -541,12 +541,13 @@ LIBUS_SOCKET_DESCRIPTOR bsd_create_listen_socket(const char *host, int port, int
+ 
+ #ifndef _WIN32
+ #include <sys/un.h>
+-#else
++#elif !defined(__MINGW32__) && !defined(__MINGW64__)
+ #include <afunix.h>
+ #include <io.h>
+ #endif
+ #include <sys/stat.h>
+ #include <stddef.h>
++#if !defined(__MINGW32__) && !defined(__MINGW64__)
+ LIBUS_SOCKET_DESCRIPTOR bsd_create_listen_socket_unix(const char *path, int options) {
+ 
+     LIBUS_SOCKET_DESCRIPTOR listenFd = LIBUS_SOCKET_ERROR;
+@@ -582,6 +583,7 @@ LIBUS_SOCKET_DESCRIPTOR bsd_create_listen_socket_unix(const char *path, int opti
+ 
+     return listenFd;
+ }
++#endif /* !MINGW */
+ 
+ LIBUS_SOCKET_DESCRIPTOR bsd_create_udp_socket(const char *host, int port) {
+     struct addrinfo hints, *result;
+@@ -659,9 +661,11 @@ LIBUS_SOCKET_DESCRIPTOR bsd_create_udp_socket(const char *host, int port) {
+     /* These are used for getting the ECN */
+     if (setsockopt(listenFd, IPPROTO_IPV6, IPV6_RECVTCLASS, (void *) &enabled, sizeof(enabled)) == -1) {
+         if (errno == 92) {
++            #if defined(IP_RECVTOS)
+             if (setsockopt(listenFd, IPPROTO_IP, IP_RECVTOS, (void *) &enabled, sizeof(enabled)) != 0) {
+                 printf("Error setting IPv4 ECN!\n");
+             }
++            #endif
+         } else {
+             printf("Error setting IPv6 ECN!\n");
+         }
+@@ -746,7 +750,7 @@ LIBUS_SOCKET_DESCRIPTOR bsd_create_connect_socket(const char *host, int port, co
+ 
+     return fd;
+ }
+-
++#if !defined(__MINGW32__) && !defined(__MINGW64__)
+ LIBUS_SOCKET_DESCRIPTOR bsd_create_connect_socket_unix(const char *server_path, int options) {
+ 
+     struct sockaddr_un server_address;
+@@ -764,4 +768,5 @@ LIBUS_SOCKET_DESCRIPTOR bsd_create_connect_socket_unix(const char *server_path,
+     connect(fd, (struct sockaddr *)&server_address, size);
+ 
+     return fd;
+-}
+\ No newline at end of file
++}
++#endif
+\ No newline at end of file
diff --git a/cmake/uSockets.cmake b/cmake/uSockets.cmake
new file mode 100644
index 000000000..ad133c565
--- /dev/null
+++ b/cmake/uSockets.cmake
@@ -0,0 +1,23 @@
+# Apply local fixes to uSockets nested submodule
+
+set(USOCKETS_PATCH
+    "${CMAKE_CURRENT_SOURCE_DIR}/../cmake/patch/uSockets/001-fix-bsd.patch"
+)
+
+if(EXISTS "${USOCKETS_PATCH}")
+  message(STATUS "Applying uSockets local patch")
+
+  execute_process(
+    COMMAND patch -p1 -N -i "${USOCKETS_PATCH}"
+    WORKING_DIRECTORY
+      "${CMAKE_CURRENT_SOURCE_DIR}/../external/uWebSockets/uSockets"
+    RESULT_VARIABLE _patch_result
+    OUTPUT_VARIABLE _patch_out
+    ERROR_VARIABLE  _patch_err
+  )
+
+  if(NOT _patch_result EQUAL 0 AND NOT _patch_result EQUAL 1)
+    message(FATAL_ERROR
+      "Failed to apply uSockets patch:\n${_patch_out}\n${_patch_err}")
+  endif()
+endif()
diff --git a/external/CMakeLists.txt b/external/CMakeLists.txt
index bc45f05f0..a20520e58 100755
--- a/external/CMakeLists.txt
+++ b/external/CMakeLists.txt
@@ -41,6 +41,7 @@ endif()
 
 if(NOT OXENC_FOUND)
    message(STATUS "Using in-tree oxen-encoding")
+   include(${CMAKE_CURRENT_SOURCE_DIR}/../cmake/oxen-encoding.cmake)
    add_subdirectory(oxen-encoding)
  else()
    add_library(oxenc INTERFACE)
@@ -51,6 +52,7 @@ endif()
 
 if(NOT OXENMQ_FOUND)
   message(STATUS "Using in-tree oxenmq")
+  include(${CMAKE_CURRENT_SOURCE_DIR}/../cmake/loki-mq.cmake)
   add_subdirectory(loki-mq)
 else()
   add_library(oxenmq INTERFACE)
@@ -72,6 +74,8 @@ add_subdirectory(nlohmann-json)
 
 # uSockets doesn't really have a proper build system (just a very simple Makefile) so build it
 # ourselves.
+include(${CMAKE_CURRENT_SOURCE_DIR}/../cmake/uSockets.cmake)
+
 if (NOT CMAKE_VERSION VERSION_LESS 3.12)
     set(conf_depends "CONFIGURE_DEPENDS")
 else()
@@ -84,13 +88,13 @@ target_compile_definitions(uSockets PRIVATE LIBUS_NO_SSL=1)
 target_include_directories(uSockets PRIVATE uWebSockets/uSockets/src)
 
 # Polyseed
-file(GLOB polyseed_src 
+file(GLOB polyseed_src
     ${CMAKE_CURRENT_SOURCE_DIR}/polyseed/src/*.c
     ${CMAKE_CURRENT_SOURCE_DIR}/polyseed/src/*.cpp
 )
 
 add_library(polyseed STATIC EXCLUDE_FROM_ALL ${polyseed_src})
-target_include_directories(polyseed PUBLIC 
+target_include_directories(polyseed PUBLIC
     ${CMAKE_CURRENT_SOURCE_DIR}/polyseed/include
 )
 
