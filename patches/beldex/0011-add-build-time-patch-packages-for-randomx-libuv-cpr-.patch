+--- a/src/bsd.c
++++ b/src/bsd.c
+@@ -541,12 +541,13 @@ LIBUS_SOCKET_DESCRIPTOR bsd_create_listen_socket(const char *host, int port, int
+ 
+ #ifndef _WIN32
+ #include <sys/un.h>
+-#else
++#elif !defined(__MINGW32__) && !defined(__MINGW64__)
+ #include <afunix.h>
+ #include <io.h>
