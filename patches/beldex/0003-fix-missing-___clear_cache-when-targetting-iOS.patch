Subject: [PATCH 03/15] fix missing ___clear_cache when targetting iOS

---
 .gitmodules               | 3 ++-
 external/randomx          | 2 +-
 src/crypto/CMakeLists.txt | 2 ++
 3 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/.gitmodules b/.gitmodules
index 088e5dba2..51a6a80fb 100644
--- a/.gitmodules
+++ b/.gitmodules
@@ -6,7 +6,8 @@
 	url = https://github.com/trezor/trezor-common.git
 [submodule "external/randomx"]
 	path = external/randomx
-	url = https://github.com/oxen-io/loki-randomXL
+	url = https://github.com/MrCyjaneK/RandomX
+	branch = cyjan-fix-ios
 [submodule "external/loki-mq"]
 	path = external/loki-mq
 	url = https://github.com/oxen-io/loki-mq.git
diff --git a/external/randomx b/external/randomx
index 006b90a48..ce72c9bb9 160000
--- a/external/randomx
+++ b/external/randomx
@@ -1 +1 @@
-Subproject commit 006b90a485b55408d772907a9b2332f55c0f5082
+Subproject commit ce72c9bb9cb799e0d9171094b9abb009e04c5bfc
diff --git a/src/crypto/CMakeLists.txt b/src/crypto/CMakeLists.txt
index 466cb1270..3b62f7615 100755
--- a/src/crypto/CMakeLists.txt
+++ b/src/crypto/CMakeLists.txt
@@ -59,6 +59,8 @@ if(MONERO_SLOW_HASH)
   target_compile_definitions(cncrypto PUBLIC ENABLE_MONERO_SLOW_HASH)
 endif()
 
+include_directories(${RANDOMX_INCLUDE})
+
 target_link_libraries(cncrypto
   PUBLIC
     epee
