Subject: [PATCH 10/16] serialize cache to JSON

---
 src/wallet/CMakeLists.txt           |  1 +
 src/wallet/api/wallet.cpp           |  6 ++++++
 src/wallet/api/wallet.h             |  2 ++
 src/wallet/api/wallet2_api.h        |  3 +++
 src/wallet/wallet2.h                |  6 ++++++
 src/wallet/wallet_cache_to_json.cpp | 29 +++++++++++++++++++++++++++++
 6 files changed, 47 insertions(+)
 create mode 100644 src/wallet/wallet_cache_to_json.cpp

diff --git a/src/wallet/CMakeLists.txt b/src/wallet/CMakeLists.txt
index 448700528..b8d2c2036 100755
--- a/src/wallet/CMakeLists.txt
+++ b/src/wallet/CMakeLists.txt
@@ -35,6 +35,7 @@ add_library(wallet
   message_store.cpp
   message_transporter.cpp
   transfer_view.cpp
+  wallet_cache_to_json.cpp
 )
 
 target_link_libraries(wallet
diff --git a/src/wallet/api/wallet.cpp b/src/wallet/api/wallet.cpp
index 39675cbb8..c3a05b869 100755
--- a/src/wallet/api/wallet.cpp
+++ b/src/wallet/api/wallet.cpp
@@ -4228,4 +4228,10 @@ uint64_t WalletImpl::getBytesSent()
     return wallet()->get_bytes_sent();
 }
 
+EXPORT
+std::string WalletImpl::serializeCacheToJson() const
+{
+    return std::string(wallet()->serialize_cache_to_json());
+}
+
 } // namespace
diff --git a/src/wallet/api/wallet.h b/src/wallet/api/wallet.h
index b847ffc30..ad0bdad83 100755
--- a/src/wallet/api/wallet.h
+++ b/src/wallet/api/wallet.h
@@ -376,6 +376,8 @@ private:
     // cache connection status to avoid unnecessary RPC calls
     mutable std::atomic<bool>   m_is_connected;
     std::optional<tools::login> m_daemon_login;
+
+    virtual std::string serializeCacheToJson() const override;
 };
 
 
diff --git a/src/wallet/api/wallet2_api.h b/src/wallet/api/wallet2_api.h
index c8fb2d1b3..113ef51c5 100755
--- a/src/wallet/api/wallet2_api.h
+++ b/src/wallet/api/wallet2_api.h
@@ -1333,6 +1333,9 @@ struct Wallet
 
     //! get bytes sent
     virtual uint64_t getBytesSent() = 0;
+
+    //! serialize wallet cache to JSON
+    virtual std::string serializeCacheToJson() const = 0;
 };
 
 /**
diff --git a/src/wallet/wallet2.h b/src/wallet/wallet2.h
index 0b63910f6..8b9af0986 100755
--- a/src/wallet/wallet2.h
+++ b/src/wallet/wallet2.h
@@ -1217,6 +1217,12 @@ private:
       FIELD(m_background_sync_data)
     END_SERIALIZE()
 
+    /*!
+     * \brief  Serialize wallet cache fields to JSON
+     * \return const char* pointing to JSON string containing all cache fields
+     */
+    const char* serialize_cache_to_json() const;
+
     /*!
      * \brief  Check if wallet keys and bin files exist
      * \param  file_path           Wallet file path
diff --git a/src/wallet/wallet_cache_to_json.cpp b/src/wallet/wallet_cache_to_json.cpp
new file mode 100644
index 000000000..fbcee1244
--- /dev/null
+++ b/src/wallet/wallet_cache_to_json.cpp
@@ -0,0 +1,29 @@
+#include "wallet2.h"
+#include "serialization/binary_archive.h"
+#include "serialization/json_archive.h"
+#include "serialization/serialization.h"
+
+namespace tools
+{
+
+const char* wallet2::serialize_cache_to_json() const
+{
+    static std::string json_result;
+
+    try
+    {
+        json_result = serialization::dump_json(
+            const_cast<wallet2&>(*this)
+        );
+    }
+    catch (const std::exception& e)
+    {
+        json_result =
+            "{\"error\":\"Failed to serialize wallet cache: " +
+            std::string(e.what()) + "\"}";
+    }
+
+    return json_result.c_str();
+}
+
+} // namespace tools
\ No newline at end of file
