From 3f830947eb21cb99438d80d5ea84d30dbce9dc98 Mon Sep 17 00:00:00 2001
From: mmokhi <mmokhi@freebsd.org>
Date: Sat, 13 Jun 2026 02:09:03 +0200
Subject: [PATCH] depends: add apple-ios host (Xcode native) + per-dep iOS
 fixes

hosts/ios.mk: build iOS deps with host Xcode (clang + iPhoneOS SDK via xcrun),
system ar/ranlib/strip. boost.mk: -std=c++14 for iOS. zeromq.mk: alias ios->
darwin in its configure OS case. toolchain.cmake.in: iOS branch (sysroot/arch/
compiler, BUILD_TAG, find-root BOTH + CMAKE_PREFIX_PATH so depends libs resolve).

external/CMakeLists.txt: on iOS use the depends-built libunbound.a instead of
rebuilding bundled unbound (getentropy_osx.c needs an SDK-absent header).
miner.cpp: gate macOS-only IOKit power-source code to TARGET_OS_OSX.

src/CMakeLists.txt + src/wallet/CMakeLists.txt: align the iOS guard set to
upstream Monero -- build blockchain_db and rpc, guard only serialization, and
guard wallet_rpc_server like Monero.
---
 contrib/depends/hosts/ios.mk       | 35 ++++++++++++++++++++++++++++++
 contrib/depends/packages/boost.mk  |  1 +
 contrib/depends/packages/zeromq.mk |  8 +++++++
 contrib/depends/toolchain.cmake.in | 24 ++++++++++++++++++++
 external/CMakeLists.txt            |  5 ++++-
 src/CMakeLists.txt                 |  6 ++---
 src/cryptonote_basic/miner.cpp     | 11 ++++++----
 src/wallet/CMakeLists.txt          |  2 ++
 8 files changed, 83 insertions(+), 9 deletions(-)
 create mode 100644 contrib/depends/hosts/ios.mk

diff --git a/contrib/depends/hosts/ios.mk b/contrib/depends/hosts/ios.mk
new file mode 100644
index 0000000..0e3cb36
--- /dev/null
+++ b/contrib/depends/hosts/ios.mk
@@ -0,0 +1,35 @@
+# Build for iOS (arm64-apple-ios) using the HOST macOS Xcode toolchain:
+# system clang + the iPhoneOS SDK (via xcrun) + system cctools (ld/ar).
+#
+# Intended to run ON a macOS runner. Unlike darwin.mk (which cross-compiles
+# from Linux and builds cctools + a downloaded SDK), nothing is built from
+# source for the toolchain here -- we use the Xcode that's already installed.
+IOS_MIN_VERSION=12.0
+IOS_SDK_PATH=$(shell xcrun --sdk iphoneos --show-sdk-path)
+
+CC_target=arm64-apple-ios
+
+ios_CC=clang -target $(CC_target) -miphoneos-version-min=$(IOS_MIN_VERSION) -isysroot $(IOS_SDK_PATH)
+ios_CXX=clang++ -target $(CC_target) -miphoneos-version-min=$(IOS_MIN_VERSION) -isysroot $(IOS_SDK_PATH) -stdlib=libc++
+
+ios_CFLAGS=-pipe
+ios_CXXFLAGS=$(ios_CFLAGS)
+ios_ARFLAGS=cr
+
+ios_release_CFLAGS=-O2
+ios_release_CXXFLAGS=$(ios_release_CFLAGS)
+
+ios_debug_CFLAGS=-g -O0
+ios_debug_CXXFLAGS=$(ios_debug_CFLAGS)
+
+# Host Xcode provides clang/ld/ar -- no native toolchain to build.
+ios_native_toolchain=
+
+ios_cmake_system=iOS
+
+# Use the system (Xcode) binutils -- there is no cross-prefixed
+# aarch64-apple-ios-ar on a native macOS host (cf. freebsd_AR=ar).
+ios_AR=ar
+ios_RANLIB=ranlib
+ios_STRIP=strip
+ios_LIBTOOL=libtool
diff --git a/contrib/depends/packages/boost.mk b/contrib/depends/packages/boost.mk
index f209c0b..0776292 100644
--- a/contrib/depends/packages/boost.mk
+++ b/contrib/depends/packages/boost.mk
@@ -22,6 +22,7 @@ $(package)_config_libraries_$(host_os)="chrono,filesystem,program_options,system
 $(package)_config_libraries_mingw32="chrono,filesystem,program_options,system,thread,test,date_time,regex,serialization,locale"
 $(package)_cxxflags_linux+=-fPIC
 $(package)_cxxflags_freebsd+=-fPIC
+$(package)_cxxflags_ios+=-fPIC -std=c++14
 endef
 
 define $(package)_preprocess_cmds
diff --git a/contrib/depends/packages/zeromq.mk b/contrib/depends/packages/zeromq.mk
index ee51843..dc3c9e8 100644
--- a/contrib/depends/packages/zeromq.mk
+++ b/contrib/depends/packages/zeromq.mk
@@ -27,3 +27,11 @@ define $(package)_postprocess_cmds
   rm -rf bin share &&\
   rm lib/*.la
 endef
+
+# zeromq's configure has no `ios` entry in its host_os case and aborts with
+# "unsupported system: ios", even though iOS is Darwin-identical for zeromq
+# (kqueue, no special ABI). Alias ios -> the existing darwin case. iOS only;
+# other hosts are untouched.
+define $(package)_preprocess_cmds
+  case "$(host_os)" in *ios*) sed -i.bak 's/\*darwin\*)/\*ios\*|\*darwin\*)/' configure ;; esac
+endef
diff --git a/contrib/depends/toolchain.cmake.in b/contrib/depends/toolchain.cmake.in
index 584f2c4..f3d2972 100644
--- a/contrib/depends/toolchain.cmake.in
+++ b/contrib/depends/toolchain.cmake.in
@@ -112,6 +112,30 @@ elseif(CMAKE_SYSTEM_NAME STREQUAL "Android")
   SET(CMAKE_ANDROID_STANDALONE_TOOLCHAIN @prefix@/native)
   SET(CMAKE_C_COMPILER "${_CMAKE_TOOLCHAIN_PREFIX}clang")
   SET(CMAKE_CXX_COMPILER "${_CMAKE_TOOLCHAIN_PREFIX}clang++")
+elseif(CMAKE_SYSTEM_NAME STREQUAL "iOS")
+  # iOS on a native macOS runner: host Xcode clang + iphoneos SDK (via xcrun),
+  # no from-source toolchain, no downloaded SDK. CMake intrinsically defines
+  # APPLE=1 and IOS=1 for CMAKE_SYSTEM_NAME=iOS, and the ARCHITECTURE=="aarch64"
+  # block below sets ARM/ARM_ID/BUILD_64 and the aarch64 AES handling -- so this
+  # branch only carries the iOS-specific SDK/arch/compiler bits.
+  SET(CMAKE_OSX_ARCHITECTURES "arm64")
+  SET(CMAKE_OSX_SYSROOT "iphoneos")
+  SET(CMAKE_OSX_DEPLOYMENT_TARGET "12.0")
+  SET(CMAKE_C_COMPILER clang)
+  SET(CMAKE_CXX_COMPILER clang++ -stdlib=libc++)
+  # Updater platform tag, <os>-<arch> like mac-armv8/android-armv8. The aarch64
+  # block below only sets BUILD_TAG for Android/Linux, so set the iOS one here
+  # (mirrors how the Darwin branch sets mac-armv8 in-branch).
+  SET(BUILD_TAG "ios-armv8")
+  # find-root mode is globally ONLY; the depends @prefix@ libs/headers are
+  # absolute paths that ONLY re-roots into nonexistent doubles, so FindOpenSSL/
+  # FindBoost can't see them under iOS. BOTH lets the absolute hints resolve.
+  SET(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY BOTH)
+  SET(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE BOTH)
+  # cncrypto does a bare find_library(SODIUM_LIBRARY sodium) with no *_ROOT hint
+  # (CMakeLists.txt:1213), so put the depends prefix on CMAKE_PREFIX_PATH for
+  # hintless finds to reach @prefix@/lib.
+  SET(CMAKE_PREFIX_PATH "@prefix@")
 else()
   SET(CMAKE_C_COMPILER @CC@)
   SET(CMAKE_CXX_COMPILER @CXX@)
diff --git a/external/CMakeLists.txt b/external/CMakeLists.txt
index 7a666b8..f07be0b 100644
--- a/external/CMakeLists.txt
+++ b/external/CMakeLists.txt
@@ -54,7 +54,10 @@ set(UPNP_LIBRARIES "libminiupnpc-static" PARENT_SCOPE)
 
 find_package(Unbound)
 
-if(NOT UNBOUND_INCLUDE_DIR OR STATIC)
+# iOS: the bundled unbound's macOS getentropy compat (getentropy_osx.c) needs
+# netinet/ip_var.h, absent from the iphoneos SDK. depends already cross-built a
+# static libunbound.a for iOS, so use it (UNBOUND_LIBRARIES) instead of rebuilding.
+if(NOT UNBOUND_INCLUDE_DIR OR (STATIC AND NOT IOS))
   # NOTE: If STATIC is true, CMAKE_FIND_LIBRARY_SUFFIXES has been reordered.
   # unbound has config tests which used OpenSSL libraries, so -ldl may need to
   # be set in this case.
diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 0e18872..45b8a06 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -113,12 +113,10 @@ add_subdirectory(cryptonote_core)
 add_subdirectory(lmdb)
 add_subdirectory(multisig)
 add_subdirectory(net)
-if(NOT IOS)
-  add_subdirectory(blockchain_db)
-endif()
+add_subdirectory(blockchain_db)
 add_subdirectory(mnemonics)
+add_subdirectory(rpc)
 if(NOT IOS)
-  add_subdirectory(rpc)
   add_subdirectory(serialization)
 endif()
 add_subdirectory(wallet)
diff --git a/src/cryptonote_basic/miner.cpp b/src/cryptonote_basic/miner.cpp
index b23d5fa..e1e24bf 100644
--- a/src/cryptonote_basic/miner.cpp
+++ b/src/cryptonote_basic/miner.cpp
@@ -51,12 +51,15 @@
 
 #ifdef __APPLE__
   #include <sys/times.h>
-  #include <IOKit/IOKitLib.h>
-  #include <IOKit/ps/IOPSKeys.h>
-  #include <IOKit/ps/IOPowerSources.h>
   #include <mach/mach_host.h>
   #include <AvailabilityMacros.h>
   #include <TargetConditionals.h>
+  // IOKit power-source APIs are macOS-only; the iphoneos SDK lacks IOKit/ps/*.
+  #if TARGET_OS_OSX
+    #include <IOKit/IOKitLib.h>
+    #include <IOKit/ps/IOPSKeys.h>
+    #include <IOKit/ps/IOPowerSources.h>
+  #endif
 #elif defined(__linux__)
   #include <unistd.h>
   #include <sys/resource.h>
@@ -1058,7 +1061,7 @@ namespace cryptonote
 
     #elif defined(__APPLE__) 
       
-      #if TARGET_OS_MAC && (!defined(MAC_OS_X_VERSION_MIN_REQUIRED) || MAC_OS_X_VERSION_MIN_REQUIRED >= MAC_OS_X_VERSION_10_7)
+      #if TARGET_OS_OSX && (!defined(MAC_OS_X_VERSION_MIN_REQUIRED) || MAC_OS_X_VERSION_MIN_REQUIRED >= MAC_OS_X_VERSION_10_7)
         return boost::logic::tribool(IOPSGetTimeRemainingEstimate() != kIOPSTimeRemainingUnlimited);
       #else
         // iOS or OSX <10.7
diff --git a/src/wallet/CMakeLists.txt b/src/wallet/CMakeLists.txt
index 93baf79..e2067fa 100644
--- a/src/wallet/CMakeLists.txt
+++ b/src/wallet/CMakeLists.txt
@@ -75,6 +75,7 @@ target_link_libraries(wallet
   PRIVATE
     ${EXTRA_LIBRARIES})
 
+if(NOT IOS)
 set(wallet_rpc_sources
   wallet_rpc_server.cpp)
 
@@ -110,6 +111,7 @@ set_property(TARGET wallet_rpc_server
   PROPERTY
     OUTPUT_NAME "nerva-wallet-rpc")
 install(TARGETS wallet_rpc_server DESTINATION bin)
+endif()
 
 
 # build and install libwallet_merged only if we building for GUI
