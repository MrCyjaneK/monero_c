+            writer << tr(". Reason: ") << e.reason();
+        setStatusError(writer.str());
+        startRefresh();
+        return false;
+    } catch (const std::exception &e) {
+        setStatusError(string(tr("Unknown exception: ")) + e.what());
+        startRefresh();
+        return false;
+    } catch (...) {
+        setStatusError(tr("Unhandled exception"));
+        startRefresh();
+        return false;
+    }
