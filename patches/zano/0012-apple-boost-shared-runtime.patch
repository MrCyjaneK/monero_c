From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Czarek Nakamoto <cyjan@mrcyjanek.net>
Date: Sat, 3 Oct 2026 16:05:00 +0200
Subject: [PATCH] use shared C++ runtime for Boost on macOS

macOS depends Boost is linked to the shared libc++. iOS Boost is the
static-runtime build, so leave Boost_USE_STATIC_RUNTIME on there.

---
 CMakeLists.txt | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 2eab048e..9c23fb7f 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -232,8 +232,13 @@ if(MSVC)
 endif()
 
 if(STATIC)  
-  set(Boost_USE_STATIC_LIBS ON)  
-  set(Boost_USE_STATIC_RUNTIME ON)
+  set(Boost_USE_STATIC_LIBS ON)
+  if(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
+    # macOS depends Boost is linked to the shared C++ runtime
+    set(Boost_USE_STATIC_RUNTIME OFF)
+  else()
+    set(Boost_USE_STATIC_RUNTIME ON)
+  endif()
 endif()
 # preconfigure boost for certain platforms
 if(Boost_FATLIB)
-- 
